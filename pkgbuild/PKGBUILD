# Maintainer: Bruno Goncalves <bigbruno@gmail.com>

pkgname=grub-btrfs-timeshift
pkgver=$(date +%Y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL')
url="https://github.com/biglinux/grub-btrfs-timeshift"
pkgdesc="Fix to timeshift and refresh grub configuration after new snapshot"
# grub provides grub-mkconfig and grub-script-check; gettext provides the menu
# text. The generators run under set -e, so a missing gettext does not just
# lose a translation, it aborts the whole grub.cfg.
depends=('timeshift' 'grub' 'grub-btrfs' 'gettext' 'inotify-tools' 'python-gobject' 'python-psutil' 'libadwaita')
source=("git+https://github.com/biglinux/grub-btrfs-timeshift.git")
md5sums=(SKIP)
if [ -e "${pkgname}.install" ];then
    install=${pkgname}.install
fi

package() {
    # Verify default folder
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}/${pkgname}"
    else
        InternalDir="${srcdir}/${pkgname}"
    fi


    # Copy files
    if [ -d "${InternalDir}/usr" ]; then
        cp -r "${InternalDir}/usr" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/etc" ]; then
        cp -r "${InternalDir}/etc" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/opt" ]; then
        cp -r "${InternalDir}/opt" "${pkgdir}/"
    fi
}
